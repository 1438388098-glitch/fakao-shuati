# 复制为 .env 或写进 systemd EnvironmentFile；所有变量均可省略
PORT=3210
# 子路径部署（nginx 反代 /shuati/ 时）
#BASE_PATH=/shuati
# 运行数据目录（SQLite、作答、批改记录）
#DATA_DIR=./data
# 题库数据目录（只读）
#FAKAO_DATA_DIR=./题库数据

# ---- AI 批改（API 填充；也可全部在网页「设置」页配置）----
# api / cli / 留空=自动（配了 API 用 API，配了 GRADER_CMD 用 CLI）
#AI_MODE=api
# openai（/chat/completions）或 anthropic（/v1/messages）
#AI_FORMAT=openai
#AI_BASE_URL=https://api.deepseek.com/v1
#AI_API_KEY=sk-xxxx
#AI_MODEL=deepseek-chat
#AI_MAX_TOKENS=16000

# ---- 高级：本地 CLI 批改（调用 AI 编码 CLI + fakao-grader 评分技能）----
#GRADER_CMD=claude -p {prompt} --dangerously-skip-permissions
#GRADER_SKILL_PATH=/root/.zcode/skills/fakao-grader/SKILL.md
