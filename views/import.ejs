<%- include('partials/head', { title }) %>
<div class="card narrow">
  <h1><%= t('import.title') %></h1>
  <p class="muted"><%= t('import.hint') %></p>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="<%= base %>/import/<%= attemptId %>">
    <label><%= t('import.jsonLabel') %></label>
    <textarea name="json" rows="10" placeholder='{"subject":...,"score":...,"subs":[...]}' required></textarea>
    <label><%= t('import.mdLabel') %></label>
    <textarea name="md" rows="6"></textarea>
    <button type="submit"><%= t('import.submit') %></button>
  </form>
</div>
<%- include('partials/foot') %>
