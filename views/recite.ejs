<%- include('partials/head', { title }) %>
<div class="page-head">
  <div class="eyebrow"><%= t('recite.eyebrow') %></div>
  <h1><%= t('recite.title') %></h1>
  <div class="sub"><%= t('recite.sub', { name: cur.name, n: cards.length, m: cards.filter(c=>c.mastered).length }) %></div>
</div>
<div class="tabs">
  <% for (const s of subjects) { %>
    <a class="tab <%= s.key === cur.key ? 'active' : '' %>" href="<%= base %>/recite?s=<%= s.key %>"><%= s.name.replace('（真题）','').replace('（选做）','') %></a>
  <% } %>
</div>
<% for (const c of cards) { const fid = 'f' + c.qid.replace(/[^a-z0-9]/gi,'') + '_' + c.subOrder; %>
  <div class="fcard <%= c.mastered ? 'done' : '' %>" id="<%= fid %>">
    <div class="finner">
      <div class="fface front">
        <div class="q" onclick="document.getElementById('<%= fid %>').classList.add('open')">
          <b><%= c.snText %></b> <span class="muted small"><%= t('common.subN', { n: c.subOrder }) %> · <%= t('common.pts', { n: c.subScore }) %></span>
          <div class="sq"><%= c.subQuestion %></div>
          <span class="hint"><%= t('recite.hintOpen') %></span>
        </div>
      </div>
      <div class="fface back">
        <div class="q" onclick="document.getElementById('<%= fid %>').classList.remove('open')">
          <b><%= c.snText %> · <%= t('common.subN', { n: c.subOrder }) %></b> <span class="hint"><%= t('recite.hintClose') %></span>
        </div>
        <p style="margin:8px 0"><%= c.answer.length > 420 ? c.answer.slice(0, 420) + '…' : c.answer %></p>
        <% if (c.points.length) { %>
        <div class="pts">
          <% for (const p of c.points) { %>
            <span class="pt"><b><%= p.score %></b><%= p.text %><%= (p.whiteList && p.whiteList.length) ? t('recite.equiv', { list: p.whiteList.map(w => w.text).join('／') }) : '' %></span>
          <% } %>
        </div>
        <% } %>
        <button class="btn ghost small mbtn" data-qid="<%= c.qid %>" data-sub="<%= c.subOrder %>"><%= c.mastered ? t('recite.unmark') : t('recite.mark') %></button>
      </div>
    </div>
  </div>
<% } %>
<script>
  document.querySelectorAll('.mbtn').forEach(b => b.onclick = async (e) => {
    e.stopPropagation();
    await fetch(base + '/api/recite/toggle', { method: 'POST', headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ qid: b.dataset.qid, subOrder: +b.dataset.sub }) });
    location.reload();
  });
</script>
<%- include('partials/foot') %>
