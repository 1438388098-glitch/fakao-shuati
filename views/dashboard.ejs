<%- include('partials/head', { title }) %>
<div class="page-head"><div class="eyebrow"><%= t('dash.eyebrow') %></div><h1><%= t('page.dashboard') %></h1></div>
<% if (!points.length) { %>
  <div class="card"><p class="muted"><%= t('dash.empty') %><a href="<%= base %>/"><%= t('dash.toBank') %></a></p></div>
<% } else { %>
<div class="card"><h2><%= t('dash.trend') %></h2><canvas id="chartTrend" height="90"></canvas></div>
<div class="card"><h2><%= t('dash.missDist') %></h2><canvas id="chartMiss" height="90"></canvas></div>
<% } %>
<h2><%= t('dash.cover') %></h2>
<% for (const c of cover) { %>
  <div class="card cover">
    <div class="cover-name"><%= c.name %> <span class="muted small"><%= c.done %>/<%= c.total %></span></div>
    <div class="bar"><div class="bar-fill" style="width:<%= c.total ? Math.round(c.done/c.total*100) : 0 %>%"></div></div>
  </div>
<% } %>
<% if (points.length) { %>
<script src="<%= base %>/vendor/chart.umd.js"></script>
<script>
  const P = <%- points %>;
  const css = getComputedStyle(document.documentElement);
  const cv = n => css.getPropertyValue(n).trim();
  Chart.defaults.color = cv('--muted');
  Chart.defaults.borderColor = cv('--line');
  new Chart(document.getElementById('chartTrend'), {
    type: 'line',
    data: { labels: P.map(p => p.label), datasets: [
      { label: t('dash.scorePct'), data: P.map(p => p.pct), borderColor: cv('--cinnabar'), tension: .3 },
      { label: t('dash.hitPct'), data: P.map(p => p.hitRate), borderColor: cv('--sage'), tension: .3 },
    ]},
    options: { animation: false, scales: { y: { min: 0, max: 100 } } }
  });
  /* 图表数据键（p.misses 的「结论/依据/分析」）来自批改 JSON，属动态数据不翻译；仅标签走 t() */
  new Chart(document.getElementById('chartMiss'), {
    type: 'bar',
    data: { labels: P.map(p => p.label), datasets: [
      { label: t('dash.typeConclusion'), data: P.map(p => p.misses['结论']), backgroundColor: cv('--cinnabar') },
      { label: t('dash.typeBasis'), data: P.map(p => p.misses['依据']), backgroundColor: cv('--amber') },
      { label: t('dash.typeAnalysis'), data: P.map(p => p.misses['分析']), backgroundColor: cv('--muted') },
    ]},
    options: { animation: false, scales: { x: { stacked: true }, y: { stacked: true } } }
  });
</script>
<% } %>
<%- include('partials/foot') %>
