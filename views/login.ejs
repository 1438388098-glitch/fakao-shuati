<%- include('partials/head', { title, showNavFlag: false }) %>
<div class="card narrow">
  <div class="lang-standalone"><%- include('partials/lang') %></div>
  <div class="page-head">
    <div class="eyebrow"><%= t('login.eyebrow') %></div>
    <h1><%= t('page.login') %></h1>
  </div>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="<%= base %>/login">
    <label><%= t('login.user') %></label>
    <input type="text" name="username" required autofocus autocomplete="username">
    <label><%= t('login.pw') %></label>
    <input type="password" name="password" required autocomplete="current-password">
    <button type="submit" class="btn primary" style="width:100%"><%= t('login.submit') %></button>
  </form>
</div>
<%- include('partials/foot') %>
