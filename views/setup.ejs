<%- include('partials/head', { title, showNavFlag: false }) %>
<div class="card narrow">
  <div class="lang-standalone"><%- include('partials/lang') %></div>
  <div class="page-head">
    <div class="eyebrow"><%= t('setup.eyebrow') %></div>
    <h1><%= t('setup.title') %></h1>
    <p class="sub"><%= t('setup.sub') %></p>
  </div>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="<%= base %>/setup">
    <label><%= t('setup.userLabel') %></label>
    <input type="text" name="username" required autofocus autocomplete="username">
    <label><%= t('setup.pwLabel') %></label>
    <input type="password" name="password" required minlength="4" autocomplete="new-password">
    <button type="submit" class="btn primary" style="width:100%"><%= t('setup.submit') %></button>
  </form>
</div>
<%- include('partials/foot') %>
