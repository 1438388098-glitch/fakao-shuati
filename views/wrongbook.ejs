<%- include('partials/head', { title }) %>
<h1><%= t('page.wrongbook') %> <span class="muted small"><%= t('wrong.count', { n: rows.length }) %></span></h1>
<% if (!rows.length) { %><div class="card"><p class="muted"><%= t('wrong.empty') %></p></div><% } %>
<% let curQ = null; %>
<% for (const w of rows) { %>
  <% if (!curQ || curQ !== w.question_id) { curQ = w.question_id; if (w.q) { %>
    <div class="card">
      <div class="subject-head">
        <h3><%= w.q.snText %></h3>
        <form method="post" action="<%= base %>/wrongbook/<%= w.id %>/rebrush"><button class="btn primary small"><%= t('wrong.rebrush') %></button></form>
      </div>
  <% } else { %>
    <div class="card"><h3><%= w.question_id %><%= t('wrong.gone') %></h3>
  <% } %>
      <ul class="misslist">
  <% } %>
        <li>
          <span class="badge fail"><%= w.reason_type %></span>
          <%= w.detail %>
          <span class="muted small"><%= (w.created_at||'').slice(0,10) %></span>
        </li>
<% } %>
<% if (rows.length) { %>
      </ul>
    </div>
<% } %>
<%- include('partials/foot') %>
