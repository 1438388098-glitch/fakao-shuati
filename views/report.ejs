<%- include('partials/head', { title }) %>
<div class="score-cards">
  <div class="card score">
    <div class="big"><span data-count="<%= data.score %>"><%= data.score %></span> <em class="muted">/ <%= data.fullScore %></em></div>
    <div class="muted"><%= q.snText %> · <%= t('report.spScore') %></div>
  </div>
  <div class="card score">
    <div class="big"><%= data.band ? data.band[0] + '~' + data.band[1] : '—' %></div>
    <div class="muted"><%= t('report.band', { t: data.tier || t('report.bandDefault') }) %></div>
  </div>
  <div class="card score">
    <div class="big"><%= data.summary ? '' : '—' %></div>
    <div class="muted"><%= data.summary || t('report.mainCause') %></div>
  </div>
</div>

<% if (data.subs && data.subs.length) { %>
<div class="card">
  <h2><%= t('report.perSub') %></h2>
  <table class="qlist">
    <thead><tr><th><%= t('report.thSub') %></th><th><%= t('report.thScore') %></th><th><%= t('report.thHits') %></th><th><%= t('report.thStatus') %></th></tr></thead>
    <tbody>
    <% for (const s of data.subs) { const hit=(s.points||[]).filter(p=>p.verdict==='✓').length; %>
      <tr>
        <td><%= t('common.subN', { n: s.subOrder }) %></td>
        <td class="mono"><%= s.score %> / <%= s.max %></td>
        <td class="mono"><%= hit %> / <%= (s.points||[]).length %></td>
        <td><% if (s.score >= s.max) { %><span class="badge ok"><%= t('report.full') %></span><% } else if (s.score <= 0) { %><span class="badge fail"><%= t('report.zero') %></span><% } else { %><span class="badge doing"><%= t('report.partial') %></span><% } %></td>
      </tr>
    <% } %>
    </tbody>
  </table>
</div>
<% } %>

<div class="card">
  <h2><%= t('report.review') %></h2>
  <div class="md"><%- mdHtml %></div>
</div>
<div class="submit-bar">
  <a class="btn ghost" href="<%= base %>/"><%= t('report.back') %></a>
  <a class="btn ghost" href="<%= base %>/wrongbook"><%= t('report.toWrong') %></a>
</div>
<%- include('partials/foot') %>
