<%- include('partials/head', { title, wideShell: true }) %>
<div class="attempt-head">
  <h1><%= q.snText %> <span class="muted small"><%= t('attempt.scoreSubs', { s: q.score, n: q.subs.length }) %></span></h1>
  <div class="timer-box">
    <select id="timerMin">
      <option value="0"><%= t('attempt.noLimit') %></option>
      <option value="50" selected><%= t('attempt.mins', { n: 50 }) %></option>
      <option value="40"><%= t('attempt.mins', { n: 40 }) %></option>
      <option value="30"><%= t('attempt.mins', { n: 30 }) %></option>
    </select>
    <span id="timerShow" class="mono">--:--</span>
    <button id="timerBtn" class="btn ghost small"><%= t('attempt.start') %></button>
  </div>
</div>
<div class="attempt-cols">
  <div class="card stem"><%- q.stem.replace(/\n/g,'<br>') %></div>
  <form id="answerForm" class="attempt-subs">
    <% const answers = JSON.parse(attempt.answers_json || '{}'); %>
    <% for (const s of q.subs) { %>
      <div class="card sub">
        <h3><%= t('common.subN', { n: s.subOrder }) %> <span class="muted small"><%= t('common.pts', { n: s.subScore }) %></span></h3>
        <p class="sq"><%= s.subQuestion %></p>
        <textarea name="sub<%= s.subOrder %>" rows="6" placeholder="<%= t('attempt.placeholder') %>"><%= answers[s.subOrder] || '' %></textarea>
      </div>
    <% } %>
    <div class="submit-bar">
      <span id="saveState" class="muted small"></span>
      <button type="button" id="submitBtn" class="btn primary"><%= t('attempt.submit') %></button>
    </div>
  </form>
</div>
<div id="gradingBox" class="card hidden grading-wait">
  <h3><%= t('attempt.grading') %><span class="pen-dots"><i></i><i></i><i></i></span></h3>
  <p class="muted" id="gradingMsg"><%= t('attempt.gradingMsg') %></p>
  <p class="muted small"><%- t('attempt.importHint', { url: base + '/import/' + attempt.id }) %></p>
</div>
<script>
  const attemptId = <%= attempt.id %>;
  const form = document.getElementById('answerForm');
  const collect = () => {
    const answers = {};
    form.querySelectorAll('textarea').forEach(t => answers[t.name.replace('sub','')] = t.value);
    return answers;
  };
  let dirty = false, elapsed = 0;
  const save = async () => {
    document.getElementById('saveState').textContent = t('attempt.saving');
    await fetch(base + '/api/attempt', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ attemptId, answers: collect(), durationSec: elapsed }) });
    document.getElementById('saveState').textContent = t('attempt.savedAt', { 0: new Date().toLocaleTimeString() });
  };
  form.addEventListener('input', () => { dirty = true; });
  setInterval(() => { if (dirty) { dirty = false; save(); } }, 5000);
  window.addEventListener('beforeunload', () => { if (dirty) { navigator.sendBeacon && navigator.sendBeacon(base + '/api/attempt', new Blob([JSON.stringify({attemptId, answers: collect(), durationSec: elapsed})], {type:'application/json'})); } });

  // 计时器
  let total = 0, timer = null;
  document.getElementById('timerBtn').onclick = () => {
    if (timer) { clearInterval(timer); timer = null; document.getElementById('timerBtn').textContent = t('attempt.resume'); return; }
    if (total === 0) { const m = +document.getElementById('timerMin').value; if (!m) { document.getElementById('timerShow').textContent = t('attempt.noLimit'); return; } total = m * 60; }
    document.getElementById('timerBtn').textContent = t('attempt.pause');
    timer = setInterval(() => {
      total--; elapsed++;
      const mm = String(Math.floor(total/60)).padStart(2,'0'), ss = String(total%60).padStart(2,'0');
      const el = document.getElementById('timerShow');
      el.textContent = mm + ':' + ss;
      el.className = total < 300 ? 'mono warn' : 'mono';
      if (total <= 0) { clearInterval(timer); timer = null; el.textContent = t('attempt.timeUp'); }
    }, 1000);
  };

  // 提交批改 + 轮询
  document.getElementById('submitBtn').onclick = async () => {
    document.getElementById('submitBtn').disabled = true;
    await save();
    const r = await fetch(base + '/api/attempt/' + attemptId + '/submit', { method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({ answers: collect(), durationSec: elapsed }) });
    if (!r.ok) { alert(t('attempt.submitFail')); document.getElementById('submitBtn').disabled = false; return; }
    document.getElementById('gradingBox').classList.remove('hidden');
    document.getElementById('gradingBox').scrollIntoView({behavior:'smooth'});
    const poll = setInterval(async () => {
      const s = await (await fetch(base + '/api/attempt/' + attemptId + '/status')).json();
      if (s.status === 'graded' && s.gradingId) { clearInterval(poll); location.href = base + '/report/' + s.gradingId; }
      if (s.status === 'failed') {
        clearInterval(poll);
        document.getElementById('gradingMsg').innerHTML = t('attempt.failedMsg', { url: base + '/import/' + attemptId });
      }
    }, 8000);
  };
</script>
<%- include('partials/foot') %>
