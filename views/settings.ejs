<%- include('partials/head', { title }) %>
<div class="card narrow">
  <h1><%= t('page.settings') %></h1>
  <% if (saved) { %><p class="ok-msg"><%= t('settings.saved') %></p><% } %>
  <% if (error) { %><p class="err"><%= error %></p><% } %>
  <form method="post" action="<%= base %>/settings">
    <label><%= t('settings.countdownLabel') %></label>
    <input type="date" name="countdown_date" value="<%= countdown %>">

    <h2 class="set-sec"><%= t('settings.aiSection') %></h2>
    <label><%= t('settings.modeLabel') %></label>
    <select name="ai_mode">
      <option value="auto" <%= aiMode === 'auto' ? 'selected' : '' %>><%= t('settings.modeAuto') %></option>
      <option value="api" <%= aiMode === 'api' ? 'selected' : '' %>><%= t('settings.modeApi') %></option>
      <option value="cli" <%= aiMode === 'cli' ? 'selected' : '' %>><%= t('settings.modeCli') %></option>
    </select>
    <label><%= t('settings.formatLabel') %></label>
    <select name="ai_format">
      <option value="openai" <%= aiFormat === 'openai' ? 'selected' : '' %>><%= t('settings.fmtOpenai') %></option>
      <option value="anthropic" <%= aiFormat === 'anthropic' ? 'selected' : '' %>><%= t('settings.fmtAnthropic') %></option>
    </select>
    <label><%= t('settings.baseUrlLabel') %></label>
    <input type="url" name="ai_base_url" value="<%= aiBaseUrl %>" placeholder="https://api.openai.com/v1" autocomplete="off">
    <label><%= t('settings.modelLabel') %></label>
    <input type="text" name="ai_model" value="<%= aiModel %>" placeholder="如 gpt-4o-mini / deepseek-chat / glm-4.7-flash" autocomplete="off">
    <label>API Key <%= aiKeyMask ? t('settings.keyMask', { m: aiKeyMask }) : '' %></label>
    <input type="password" name="ai_api_key" placeholder="<%= aiKeyMask ? t('settings.keyPlaceholder') : 'sk-…' %>" autocomplete="off">
    <% if (aiKeyMask) { %>
      <label class="chk"><input type="checkbox" name="ai_clear_key" value="1" style="width:auto"> <%= t('settings.clearKey') %></label>
    <% } %>
    <p class="muted small"><%= t('settings.keyNote') %></p>

    <h2 class="set-sec"><%= t('settings.account') %></h2>
    <label><%= t('settings.oldPw') %></label>
    <input type="password" name="old_password" autocomplete="off">
    <label><%= t('settings.newPw') %></label>
    <input type="password" name="new_password" autocomplete="off" minlength="6">
    <button type="submit"><%= t('settings.save') %></button>
  </form>
  <p class="muted small"><%= t('settings.exportNote') %></p>
</div>
<%- include('partials/foot') %>
